{
  "name": "fastapi-movie-19",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n back,front -c cyan,magenta \"npm:dev:back\" \"npm:dev:front\"",
    "dev:back": "cd backend && .venv\\Scripts\\python -m uvicorn main:app --reload --port 8000",
    "dev:front": "npm --prefix frontend run dev",
    "setup": "npm install && npm --prefix frontend install && cd backend && python -m venv .venv && .venv\\Scripts\\python -m pip install -r requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
